{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name', 'gender', 'color'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "gender": {
          ".validate": "newData.val() === 'male' || newData.val() === 'female'"
        },
        "color": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      },
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true"
    },
    "lobby": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "x": {
            ".validate": "newData.isNumber()"
          },
          "y": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "chat": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && (!newData.exists() || (!data.exists() && newData.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          }
        }
      },
      "roomMembers": {
        ".read": "auth != null",
        "$n": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "roomLocks": {
        ".read": "auth != null",
        "$n": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "rooms": {
      "$n": {
        ".read": "auth != null",
        ".validate": "$n === '1' || $n === '2' || $n === '3' || $n === '4'",
        "host": {
          ".write": "auth != null"
        },
        "locked": {
          ".write": "auth != null"
        },
        "state": {
          ".write": "auth != null"
        },
        "game": {
          ".write": "auth != null"
        },
        "invite": {
          ".write": "auth != null",
          "value": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          }
        },
        "votes": {
          ".write": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "players": {
          ".write": "auth != null"
        },
        "chat": {
          "$id": {
            ".write": "auth != null && (!newData.exists() || (!data.exists() && newData.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
            }
          },
          ".write": "auth != null && !newData.exists()"
        }
      }
    },
    "board": {
      "posts": {
        ".read": "auth != null",
        "$slot": {
          ".write": "auth != null && $slot.matches(/^[0-9]$/) && ((newData.exists() && (!data.exists() || (root.child('board/posts/0/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/1/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/2/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/3/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/4/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/5/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/6/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/7/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/8/createdAt').val() >= data.child('createdAt').val() && root.child('board/posts/9/createdAt').val() >= data.child('createdAt').val()))) || (!newData.exists() && data.exists() && root.child('board/deleteTickets/' + $slot + '/' + auth.uid).val() === root.child('board/postSecrets/' + $slot).val()) || (!newData.exists() && root.child('admins/' + auth.uid).val() === true))",
          ".validate": "newData.hasChildren(['image', 'name', 'date', 'createdAt'])",
          "image": {
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 140000"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "postSecrets": {
        "$slot": {
          ".write": "auth != null && ((newData.exists() && newData.parent().parent().child('posts/' + $slot + '/createdAt').val() === now) || (!newData.exists() && root.child('board/deleteTickets/' + $slot + '/' + auth.uid).val() === root.child('board/postSecrets/' + $slot).val()) || (!newData.exists() && root.child('admins/' + auth.uid).val() === true))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
        }
      },
      "deleteTickets": {
        "$slot": {
          ".write": "auth != null && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && root.child('admins/' + auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    }
  }
}