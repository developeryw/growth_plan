{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'gender', 'color'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "gender": {
          ".validate": "newData.val() === 'male' || newData.val() === 'female'"
        },
        "color": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "lobby": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "x": {
            ".validate": "newData.isNumber()"
          },
          "y": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "chat": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && (!newData.exists() || (!data.exists() && newData.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          }
        }
      },
      "roomMembers": {
        ".read": "auth != null",
        "$n": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "roomLocks": {
        ".read": "auth != null",
        "$n": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "rooms": {
      "$n": {
        ".read": "auth != null",
        ".validate": "$n === '1' || $n === '2' || $n === '3' || $n === '4'",
        "host": {
          ".write": "auth != null"
        },
        "locked": {
          ".write": "auth != null"
        },
        "state": {
          ".write": "auth != null"
        },
        "game": {
          ".write": "auth != null"
        },
        "invite": {
          ".write": "auth != null",
          "value": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          }
        },
        "votes": {
          ".write": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "players": {
          ".write": "auth != null"
        },
        "chat": {
          "$id": {
            ".write": "auth != null && (!newData.exists() || (!data.exists() && newData.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
            }
          },
          ".write": "auth != null && !newData.exists()"
        }
      }
    }
  }
}